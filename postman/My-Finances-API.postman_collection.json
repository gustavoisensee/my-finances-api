			"item": [
				{
					"name": "Get All Years",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text",
								"description": "Firebase ID token (set auth_token to the raw token, without 'Bearer ')"
							}
						],
						"url": {
							"raw": "{{base_url}}/year?take=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"year"
							],
							"query": [
								{
									"key": "take",
									"value": "10",
									"description": "Number of records to return (default 10, max 100)"
								}
							]
						},
						"description": "Get all years. Years are created by the seed (`cargo run --bin seed`)."
					},
					"response": []
				}
			],
			"description": "Year endpoints (require authentication)"
