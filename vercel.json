{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "build": {
    "env": {
      "SQLX_OFFLINE": "true"
    }
  },
  "functions": {
    "api/main.rs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/main"
    }
  ]
}
