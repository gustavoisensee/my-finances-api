  "query": "\n        SELECT i.id, i.description, i.value, i.index,\n               i.\"createdAt\" AS created_at, i.\"monthId\" AS month_id\n        FROM \"Income\" i JOIN \"Month\" m ON m.id = i.\"monthId\"\n        WHERE i.id = $1 AND m.\"userId\" = $2\n        FOR UPDATE OF i\n        ",
