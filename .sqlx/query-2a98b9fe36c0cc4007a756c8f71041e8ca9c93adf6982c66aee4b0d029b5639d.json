  "query": "\n        SELECT b.id, b.description, b.value, b.color, b.index,\n               b.\"createdAt\" AS created_at, b.\"monthId\" AS month_id\n        FROM \"Budget\" b JOIN \"Month\" m ON m.id = b.\"monthId\"\n        WHERE b.id = $1 AND m.\"userId\" = $2\n        FOR UPDATE OF b\n        ",
