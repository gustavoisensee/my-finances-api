  "query": "\n        SELECT b.id, b.description, b.value, b.color, b.index,\n               b.\"createdAt\" AS created_at, b.\"monthId\" AS month_id\n        FROM \"Budget\" b JOIN \"Month\" m ON m.id = b.\"monthId\"\n        WHERE m.\"userId\" = $1\n        ORDER BY b.index, b.id\n        LIMIT $2\n        ",
