  "query": "\n        UPDATE \"Month\"\n        SET value = $3,\n            description = COALESCE($4, description),\n            \"yearId\" = COALESCE($5, \"yearId\")\n        WHERE id = $1 AND \"userId\" = $2\n        RETURNING id, value, description, \"createdAt\" AS created_at, \"yearId\" AS year_id, \"userId\" AS user_id\n        ",
