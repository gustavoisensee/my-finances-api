  "query": "\n        UPDATE \"Budget\"\n        SET description = $2,\n            value = $3,\n            color = CASE WHEN $4 THEN $5 ELSE color END,\n            \"monthId\" = $6,\n            index = COALESCE($7, index)\n        WHERE id = $1\n        RETURNING id, description, value, color, index, \"createdAt\" AS created_at, \"monthId\" AS month_id\n        ",
