{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.description, i.value, i.index,\n               i.\"createdAt\" AS created_at, i.\"monthId\" AS month_id\n        FROM \"Income\" i JOIN \"Month\" m ON m.id = i.\"monthId\"\n        WHERE m.\"userId\" = $1\n        ORDER BY i.index, i.id\n        LIMIT $2\n        ",
