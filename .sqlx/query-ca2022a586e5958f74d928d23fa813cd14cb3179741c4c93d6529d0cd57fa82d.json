  "query": "\n        UPDATE \"Income\"\n        SET value = $2,\n            description = CASE WHEN $3 THEN $4 ELSE description END,\n            \"monthId\" = $5,\n            index = COALESCE($6, index)\n        WHERE id = $1\n        RETURNING id, description, value, index, \"createdAt\" AS created_at, \"monthId\" AS month_id\n        ",
