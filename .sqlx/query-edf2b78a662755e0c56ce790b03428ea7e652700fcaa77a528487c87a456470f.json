{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.id, e.description, e.value, e.\"createdAt\" AS created_at,\n               e.\"budgetId\" AS budget_id, e.\"categoryId\" AS category_id\n        FROM \"Expense\" e\n        JOIN \"Budget\" b ON b.id = e.\"budgetId\"\n        JOIN \"Month\" m ON m.id = b.\"monthId\"\n        WHERE m.\"userId\" = $1\n        ORDER BY e.id\n        LIMIT $2\n        ",
