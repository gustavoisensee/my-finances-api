# Database Configuration
# ======================
# Get this from your Supabase project dashboard
# Settings → Database → Connection String
#
# Runtime (Vercel): use the pooled connection (port 6543, PgBouncer transaction mode).
# `pgbouncer=true` disables prepared-statement caching, which PgBouncer can't share.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Migrations (`sqlx migrate run`) and `cargo sqlx prepare`: use the direct connection (port 5432),
# e.g. by overriding DATABASE_URL for that one command.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional pool tuning (defaults shown)
# DB_MAX_CONNECTIONS=5
# DB_STATEMENT_CACHE_CAPACITY=0   # defaults to 0 when DATABASE_URL contains pgbouncer=true, otherwise 100

# Firebase Auth
# =============
# Only the project ID is needed: ID tokens are verified against Google's public keys,
# so no service-account credentials are required.
FIREBASE_PROJECT_ID=your-project-id

# Optional: comma-separated Firebase Auth UIDs that may call admin routes (without custom claims)
# ADMIN_FIREBASE_UIDS=uid1,uid2

# Environment
# ===========
# "production" hides internal error details and disables the localhost CORS origin.
# When unset, Vercel's VERCEL_ENV is used instead.
# APP_ENV=development

# Local server port (cargo run)
PORT=3001

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace [PROJECT-REF], [PASSWORD], and [REGION] with your Supabase credentials
# 3. Never commit the .env file to version control
